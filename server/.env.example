# Cổng lắng nghe (mặc định 8080 khớp với client_godot/project.godot; Render tự cấp PORT)
HOST=0.0.0.0
PORT=8080

# Chuỗi kết nối MongoDB Atlas (thay thông tin Database User và cluster của bạn)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/bangbang?retryWrites=true&w=majority
DB_NAME=bangbang

# Đặt =true trên Render để tránh chạy nhầm file local tạm nếu sai cấu hình Atlas
MONGODB_REQUIRED=false

# URL công khai của Cloudflare R2 / CDN chứa thư mục /godot/ (a/, av/, lv/, mu/)
# Ví dụ: https://pub-xxxxxxxxxxxx.r2.dev
ASSET_CDN_URL=

# Nếu trên CDN đặt trực tiếp a/, av/ ở gốc (không có tiền tố /godot), đổi thành true
ASSET_CDN_STRIP_GODOT=false

# Tự chèn window.__bbAssetRoot vào index.html của Godot Web để tải thẳng từ R2 (giảm 100% tải cho Render)
INJECT_ASSET_CDN=true

# Chế độ Cross-Origin Isolation cho Godot Web HTML5:
# - off (khuyên dùng cho bản export Single-Thread, chạy mượt cả iOS Safari & tải R2 không lỗi CORP)
# - credentialless (bật SharedArrayBuffer trên Chrome/Edge/Firefox mà vẫn cho tải asset R2)
# - require-corp (bật SharedArrayBuffer chặt, yêu cầu CDN gửi Cross-Origin-Resource-Policy: cross-origin)
COOP_COEP_MODE=off

# Nhịp giữ kết nối WebSocket qua proxy (ms)
WS_HEARTBEAT_MS=25000

# Khóa ký phiên (Render Blueprint tự sinh ngẫu nhiên)
SESSION_SECRET=change-this-secret-for-production
