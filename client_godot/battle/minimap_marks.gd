static func in_ranges(ranges: Array, id: int) -> bool:
	var low: int = 0
	var high: int = ranges.size() - 1
	while low <= high:
		var mid: int = (low + high) >> 1
		var pair: Array = ranges[mid]
		if id < int(pair[0]):
			high = mid - 1
		elif id > int(pair[1]):
			low = mid + 1
		else:
			return true
	return false
