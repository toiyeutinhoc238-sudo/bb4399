const OPPOSE = {"10000001": [10000008, "Spider Man có chiêu khống chế và chiêu bất bại, khiến chiêu của Iron Man khó phát huy hiệu quả."], "10000002": [10000070, "[E-Thuấn Di Truy Hồn] của Deadpool bỏ qua giáp vật lý của Groot để gây sát thương; Groot lại chậm chạp, Deadpool có thể đánh lùi Groot vào giữa đội mình để cả đội dồn hỏa lực hạ gục."], "10000003": [10000056, "[E-Tâm Như Chỉ Thủy] cho Panda lá chắn để sống sót lúc ít máu, nhưng [Space-Thanh Long Yển Nguyệt Trảm] của Quan Công bỏ qua lá chắn và kết liễu Panda."], "10000008": [10000003, "[E-Tĩnh Tâm] của Panda có thể loại bỏ tất cả hiệu quả xấu, khiến [Space-Mạng Nhện Độc] của Spider Man mất tác dụng."], "10000019": [10000064, "Gundam công cao máu mỏng, bắn xa; Thần Chết có chiêu dịch chuyển, áp sát nhanh khiến Gundam mất ưu thế tầm bắn, chuỗi chiêu bạo phát cao khiến Gundam không kịp trở tay."], "10000029": [10000048, "Sát Thủ bạo phát rất cao, có thể tàng hình áp sát Chopper và hạ gục thật nhanh, Chopper không kịp hồi máu."], "10000030": [10000047, "Dấu ấn dẫn điện của Pikachu có hiệu quả phát hiện tàng hình, khiến Dark Knight ẩn thân vô tác dụng, không còn chỗ trốn."], "10000031": [10000029, "Captain có khả năng tăng ích cho đội, nếu trong đội có Chopper, có thể tăng mạnh khả năng sinh tồn cho đội, và chống lại Captain địch."], "10000032": [10000070, "[E-Thuấn Di Truy Hồn] của Deadpool bỏ qua giáp vật lý của Teddy Bear để gây sát thương; Teddy Bear lại chậm chạp, Deadpool có thể đánh lùi Teddy Bear vào giữa đội mình để cả đội dồn hỏa lực hạ gục."], "10000033": [10000059, "Dùng hiệu quả bất bại của [E-Phụng Vũ Cửu Thiên] quét sạch bẫy của Pea Shooter, rồi dùng [Space-Liệt Diễm Xung Kích] gây sát thương và im lặng, phối hợp đồng đội hạ gục."], "10000034": [10000039, "Đánh thường và chiêu của Thor khi trúng gây thêm sát thương theo % máu tối đa. Hulk máu rất dày nên sát thương của Thor lên Hulk cực kỳ đáng kể."], "10000035": [10000030, "[Space-Bão Phi Tiêu Độc] của Dark Knight bỏ qua lá chắn [Bị Động-Ý Chí Nữ Thần] của Pegasus, vẫn gây sát thương."], "10000036": [10000032, "[Space-Năng Lượng Gỗ] của Teddy Bear xoá hiệu quả giảm sát thương Đồng Bì Thiết Cốt của Ngộ Không, khiến Ngộ Không mất phòng thủ."], "10000037": [10000041, "Tận dụng tầm bắn xa, đánh thường rút máu Hồ Lô đồng thời tích dấu ấn tinh linh, rồi tung [E-Mũi Tên Tinh Linh] và [Space-Cơn Thịnh Nộ Của Rừng] bạo phát, khiến Hồ Lô không kịp trở tay."], "10000038": [10000059, "Tận dụng [E-Phụng Hoàng Xuất Chiến] tiếp cận Ghost Rider, dùng [Space-Liệt Diễm Xung Kích] gây sát thương và im lặng, hạ gục Ghost Rider. Ngoài ra, [Space-Liệt Diễm Xung Kích] Phượng Hoàng Lửa có thể giúp đồng đội gián đoạn hiệu quả giam chân [Trói Hồn]  của Ghost Rider."], "10000039": [10000064, "Thor công mạnh máu yếu, có thể dùng [E-Ma Ảnh] nhanh chóng tiếp cận Thor, bắn đạn thường để cộng dồn Hồn Lực, rồi dùng [Space-Bankai] bạo phát hạ gục Thor."], "10000040": [10000078, "Người Sói giáp vật lý cao, chiêu của Mikasa lại gây sát thương lớn lên mục tiêu như vậy. Dùng combo [E-Móc Câu Bắn Đi] và [Space-Trảm Kích Xoay Vòng] bạo phát để gây sát thương cực lớn lên Người Sói."], "10000041": [10000077, "Legolas bắn nhanh, đánh thường và chiêu đều là sát thương dạng đạn, đều bị [R-Tay Không Đỡ Kiếm] của Zoro chặn hiệu quả."], "10000042": [10000032, "[Space-Năng Lượng Gỗ] của Teddy Bear xoá hiệu quả tăng cường khi biến hình của Songoku, khiến Songoku mất khả năng bạo phát và chạy thoát."], "10000043": [10000052, "[Space-Sức Mạnh Thánh Gióng] chắc chắn trúng, nhưng [E-Bí Ngô Ma Trơi] của Xe Bí Ngô cho 1 giây bất bại, né được đòn truy kích chí mạng của Thánh Gióng."], "10000044": [10000069, "Bò Cạp Độc có chiêu xuyên vật cản, phối hợp [E-Ô Nhiễm Chí Mạng] và [Space-Tử Vong Thôn Phệ] cộng dồn độc bò cạp lên nhiều tầng rồi dùng [R-Độc Tố Bùng Nổ] kích nổ, Naruto không còn đường thoát."], "10000045": [10000065, "Chiêu bị động của Tiên Cá gây sát thương theo % máu tối đa lên Bọt Biển, hiệu quả rất cao; chiêu của Tiên Cá lại khống chế mạnh khiến Bọt Biển khó thoát."], "10000046": [10000079, "Bị động của Luffy miễn dịch mọi sát thương vật lý, còn Thủy Tinh là tank năng lượng, có thể tận dụng tầm xa gây sát thương lên Luffy mà không bị đánh trúng."], "10000047": [10000046, "Pikachu chủ yếu gây sát thương cận chiến, mà Luffy có thể đánh lui Pikachu, ngăn cản Pikachu tiếp cận."], "10000048": [10000037, "Giáp từ [E-Giáp Hồ Lô] của Hồ Lô có hiệu quả phát hiện tàng hình, vô hiệu ẩn thân của Sát Thủ."], "10000049": [10000051, "Sơn Tinh có tầm bắn xa hơn Transformer, có thể tận dụng [E-Say Máu] và [Space-Thần Núi Đến] để khống chế Transformer rồi hạ gục."], "10000050": [10000061, "Thợ Săn Thời Gian tận dụng [Space-Lỗ Đen Không Gian] để tập trung mục tiêu tạo sát thương nhóm, mà Thiên Thần có thể dùng [Space-Thanh Tẩy], giúp đồng đội miễn dịch sát thương, vô hiệu sát thương của Thợ Săn Thời Gian."], "10000051": [10000038, "Ghost Rider có thể kéo Sơn Tinh đến nơi đồng đội đang tập trung, khiến Sơn Tinh mất ưu thế đánh tầm xa, rồi sau đó cả đội đánh hội đồng."], "10000052": [10000060, "Hồn ma do Xe Bí Ngô triệu hồi sẽ đuổi theo bệ pháo của Minion, nên Minion có thể dùng bệ pháo hứng sát thương, khiến hồn ma không đánh trúng hiệu quả."], "10000053": [10000078, "Superman giáp vật lý cao, chiêu của Mikasa lại gây sát thương lớn lên mục tiêu như vậy. Dùng combo [E-Móc Câu Bắn Đi] và [Space-Trảm Kích Xoay Vòng] bạo phát để gây sát thương cực lớn lên Superman."], "10000054": [10000049, "Transformer có thể khống chế khiến Ông Già Noel không triệu hồi được tuần lộc, rồi dùng sát thương cao hạ gục."], "10000055": [10000058, "Khi Kakashi ít máu dùng Thế Thân Thuật để thoát, hiệu quả [E-Bí Thuật Dị Xà] của Medusa sẽ nảy sát thương giữa Kakashi và khúc gỗ, khiến Kakashi không thoát được."], "10000056": [10000067, "Chiêu của Triệu Vân khống chế mạnh, khiến Quan Công không ra được combo, khả năng cơ động cao cũng không phát huy được!"], "10000057": [10000055, "[Space-Lôi Thiết Đao] Kakashi có thể giúp đồng đội gián đoạn nghi thức đổi máu của Dracula, giảm mạnh khả năng sinh tồn của Dracula."], "10000058": [10000048, "Lá chắn của Medusa miễn dịch sát thương năng lượng, nhưng Sát Thủ tàng hình áp sát rồi mở [Space-Ám Sát Chí Mạng] gây sát thương vật lý bạo phát cao, thường hạ gục chỉ trong một đòn."], "10000059": [10000050, "Thợ Săn Thời Gian có thể dùng [E-Đảo Ngược Thời Gian] đánh dấu ký hiệu lên Phượng Hoàng khi niết bàn. Khiến Phượng Hoàng hồi sinh của có 1 HP."], "10000060": [10000058, "Hiệu quả [E-Rắn Ma Thuật] của Medusa sẽ hình thành sát thương đạn giữa Minion và Bệ Pháo của Minion gọi ra, mỗi khi bắn đạn thành công 1 lần, CD [E-Rắn Ma Thuật] Medusa sẽ giảm."], "10000061": [10000074, "Điêu Thuyền có thể dùng [E-Khuynh Quốc Khuynh Thành] khống chế Thiên Thần, khiến Thiên Thần không ra được combo, không kịp hồi máu."], "10000062": [10000040, "Optimus Prime là tank đỡ đòn máu dày, chiêu của Người Sói bỏ qua hiệu quả giảm sát thương và gây sát thương theo % máu tối đa, hiệu quả rất rõ rệt."], "10000063": [10000075, "Thạch Sanh công cao máu thấp, Lữ Bố tiếp cận Thạch Sanh, sau khi khống chế có thể hạ gục nhanh, trở tay không kịp."], "10000064": [10000043, "[E-Trúc Trận Pháp] của Thánh Gióng hất tung Thần Chết, phá combo; [Space-Sức Mạnh Thánh Gióng] khiến khả năng cơ động để chạy thoát của Thần Chết vô dụng, không còn đường thoát."], "10000065": [10000066, "[R-Lý Tưởng Hương Xa Xôi] của Edwina Knight hoá giải hoàn toàn [Space-Hồng Đào Cự Lãng] và chiêu bị động của Tiên Cá."], "10000066": [10000049, "Chiêu của Transformer không có sát thương dạng đạn, nên [R-Lý Tưởng Hương Xa Xôi] của Edwina Knight không chặn được, khả năng sinh tồn giảm mạnh."], "10000067": [10000063, "Thạch Sanh có ưu thế tầm bắn xa, né hiệu quả khống chế của Triệu Vân và rút máu Triệu Vân từ ngoài tầm chiêu."], "10000069": [10000003, "[E-Tâm Tĩnh Như Thủy] của Panda loại bỏ mọi hiệu quả xấu, khiến Bò Cạp Độc không cộng dồn được nhiều tầng độc để bạo phát."], "10000070": [10000068, "[E-Bẫy Mây Sấm] của Điện Hồn gây hỗn loạn Deadpool, khiến Deadpool không phát huy được ưu thế dịch chuyển; hỗn loạn còn khiến Deadpool không thoát được sau khi hồi sinh."], "10000071": [10000048, "Sát Thủ có thể tàng hình lặng lẽ áp sát Joker, dùng bạo phát cao hạ gục trong chớp mắt."], "10000072": [10000064, "Thần Chết cơ động cao, chuỗi chiêu liên hoàn, có thể nhanh chóng áp sát Apocalypse rồi bạo phát hạ gục."], "10000073": [10000057, "Baymax có khả năng trị liệu, duy trì máu cho bản thân, mà Dracula dùng [Space-Lễ Nghi Blood] đổi máu, có thể phản kích Baymax."], "10000074": [10000038, "[E-Móc Sắt Ác Linh] của Ghost Rider kéo Điêu Thuyền lại gần, khiến Điêu Thuyền mất ưu thế tầm xa, không tung được mê hoặc và quạt bay."], "10000075": [10000074, "Mê hoặc của Điêu Thuyền bỏ qua trạng thái không thể ngăn cản sau [Space-Quỷ Thần Giáng Lâm] của Lữ Bố, phá vỡ combo tấn công."], "10000076": [10000079, "Thủy Tinh cộng dồn dấu ấn để đóng băng Kaneki, khiến Kaneki không tung được chiêu giữ mạng [R-Hách Tử Tiến Hoá]."], "10000077": [10000073, "[R-Tay Không Đỡ Kiếm] của Zoro không chặn được sát thương [Space-Siêu Năng Xung Kích] của Baymax, khả năng sinh tồn giảm."], "10000078": [10000071, "[Space-Át Chủ Bài] của Joker ép Mikasa không dám dùng chiêu di chuyển [E-Móc Câu Bắn Đi], nếu không sẽ nhận sát thương chí mạng."], "10000079": [10000032, "[E-Sinh Mệnh Hộ Hựu] của Teddy Bear xoá dấu ấn của Thủy Tinh, không bị đóng băng, khiến Thủy Tinh mất ưu thế chiêu lớn nhất."], "10000080": [10000076, "[R-Hách Tử Tiến Hoá] của Kaneki khiến sát thương vốn yếu của Doraemon không còn uy hiếp; Kaneki bám dai, Doraemon không có chiêu di chuyển nên không thoát được."], "10000081": [10000078, "[E-Mũi Lao Mốc] của Mikasha nhanh chóng tiếp cận Kiếm Thần, áp sát sẽ giảm bớt khả năng của Kiếm Thần."], "10000082": [10000077, "Phần lớn chiêu của Na Tra là chiêu đường đạn, dễ bị [R-Tay Không Đỡ Kiếm] của Zoro khắc chế."], "10000083": [10000071, "Doctor Strange có thể dễ dàng ra vào chiến trường gây sát thương bất ngờ, nhưng Joker có thể dùng [Space-Lá Bài Phép Thuật] cầm chân lại"], "10000084": [10000063, "Sát thương của Thạch Sanh dựa vào đánh thường, Ngọa Long Thần Sách · Sương của Gia Cát Lượng không phản chế được; Thạch Sanh lại đứng xa phía sau, Gia Cát Lượng khó tiếp cận."], "10000085": [10000060, "Bệ pháo của Minion rất dễ khiến [R-Nghệ Thuật Chiến Tranh] tự khoá mục tiêu đánh nhầm, năng lượng Athena tích được không gây ra sát thương."], "10000086": [10000079, "Khống chế mạnh của Thủy Tinh dễ khiến Cửu Vĩ Hồ đang chờ hồi chiêu khó thoát."], "10000087": [10000086, "Chiêu của Dương Tiễn khó trúng Cửu Vĩ Hồ linh hoạt."], "10000088": [10000066, "Đạn của Edwina Knight sẽ vô hiệu hóa DPS của Gilgamesh."], "10000089": [10000001, "Choáng của Iron Man dễ trúng khi áp sát, Star Lord lại mỏng manh nên dễ bị hạ gục tức thì."], "10000090": [10000078, "Natsu rất trâu, nhưng dễ bị Mikasa dắt mũi khắc chế gây sát thương cao"], "10000091": [10000084, "Ngọa Long Sách của Gia Cát Lượng có thể miễn dịch hiệu quả khống chế của Tào Tháo, có thể gây uy hiếp đến Tào Tháo."], "10000092": [10000085, "Bảo hộ của Athena khiến Hades khó có thể gây sát thương, nhận hồi HP."], "10000093": [10000071, "Khi trúng chiêu Space của Joker, hãy cẩn thận khi dùng chiêu R và chiêu E."], "10000094": [10000078, "[E-Mũi Lao Mốc] của Mikasha nhanh chóng trốn thoát Lạc Long Quân , hãy tận dụng"], "10000095": [10000093, "[Thuấn Di Thuật] của Sasuke có thể nhanh chóng tiếp cận Kurumi, chú ý lúc hắn thi triển [Thuấn Di Thuật] thì dừng tấn công và cẩn thận sử dụng phân thân."], "10000096": [10000095, "Kurumi rất linh hoạt có thể né tránh được tấn công của Kirito, chú ý thời cơ tấn công, tránh bị ngộ nạn."], "10000097": [10000066, "Edwina Knight dùng chiêu R để biến mất, không chỉ áp sát gây sát thương lên Magneto mà còn khiến chiêu cuối của Magneto đánh hụt."], "10000098": [10000077, "[R Cửu Thuật Kiếm] của Zoro có thể phản Đạn space của Tư Mã Ý"], "10000099": [10000086, "Tính cơ động cao của Yêu Hồ có thể dễ dàng tránh được [E Lạc Anh Tam Thức] 