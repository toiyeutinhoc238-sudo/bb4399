const DIRECT = {"11": [1, 14, "【#name#】, tôi là giáo quan Đào Đào. Bạn đã sẵn sàng chiến đấu chưa?", "Tôi sẵn sàng rồi!", "", 0, 0, "", ""], "12": [1, 0, "Hai kỹ năng tôi vừa dạy lợi hại chứ? Ngay cả phi thuyền ngoài hành tinh cũng không chịu nổi sức mạnh đó!", "Trông lợi hại thật!", "new_tianqi_t.swf", 0, 8001, "\\ui\\levelup.mp3", ""], "13": [2, 0, "", "", "", 104, 0, "", ""], "14": [1, 13, "Trước tiên, hãy đến trại huấn luyện để học điều khiển tank. Những trận chiến cam go đang chờ bạn phía trước.", "Bắt đầu thôi!", "", 0, 0, "", ""], "22": [4, 0, "Trước khi huấn luyện thực chiến, hãy cho tôi biết tên bạn. Biết đâu sau này tên bạn sẽ xuất hiện trên bảng anh hùng!", "", "", 0, 0, "", "GuideEditName"], "31": [1, 0, "【#name#】, nhiệm vụ đầu tiên của bạn là tiêu diệt tổ chức lính đánh thuê độc ác. Nhiệm vụ này không được xin nghỉ đâu!", "Cho tôi xin nghỉ với! T-T", "yd_011_t.swf", 201, 0, "", ""], "32": [1, 0, "Trợ thủ tôi tặng bạn lợi hại chứ? Hãy chăm sóc nó thật tốt nhé!", "Cảm ơn, tôi thích lắm!", "yd_012_t.swf", 0, 8003, "\\ui\\levelup.mp3", ""], "41": [1, 0, "Đây là thời trang nhân vật bạn nhận được từ nhiệm vụ. Nó thay đổi diện mạo và ảnh đại diện. Mặc thử nào!", "Để tôi thử xem!", "yd_021_t.swf", 0, 0, "", ""], "42": [1, 0, "Nếu cần người hướng dẫn thêm, bạn có thể tìm một sư phụ để cùng tiến bộ.", "Tìm sư phụ", "", 0, 0, "", ""], "43": [1, 44, "Bạn đã biết điều khiển tank rồi. Tiếp theo là đấu trường, nơi bạn thi đấu với những người chơi khác. Muốn biết cách chơi chứ?", "Tôi muốn thử!", "", 0, 0, "", ""], "44": [1, 0, "Bây giờ tôi sẽ hướng dẫn bạn cách chiến đấu trong đấu trường.", "Được thôi!", "", 0, 0, "", ""], "45": [1, 0, "Bạn đã hiểu luật đấu và có tank mạnh hơn rồi. Hãy vào So tài thử sức nhé!", "Tôi nóng lòng lắm rồi!", "", 0, 0, "", ""], "46": [1, 0, "Đã hiểu luật đấu rồi thì hãy nâng cấp tank để sẵn sàng bước vào đấu trường.", "Tôi muốn tank mạnh hơn!", "", 0, 8005, "", ""], "49": [1, 0, "Hãy dùng tank Iron Man tham gia một trận đấu. Tôi sẽ tặng bạn một gói quà lớn!", "Tôi mong nhận quà quá!", "", 0, 0, "", ""], "50": [1, 0, "Quà hấp dẫn chứ? Hãy tiếp tục chiến đấu và lên cấp. Phụ bản cũng có nhiều điều thú vị đang chờ bạn!", "Tuyệt quá!", "", 0, 0, "", ""], "51": [1, 53, "【#name#】, tiếp theo là bài huấn luyện cuối: So tài. Bạn sẽ thích cảm giác thi đấu này đấy!", "Tôi thích thử thách!", "yd_031_t.swf", 0, 0, "", ""], "52": [1, 0, "Chúc mừng 【#name#】 đã vượt qua huấn luyện tân binh! Hãy tiếp tục thể hiện thật tốt nhé!", "Giáo quan cứ yên tâm!", "yd_032_t.swf", 0, 8005, "\\ui\\levelup.mp3", ""], "53": [1, 0, "Bắt đầu bài học đấu tiêu diệt. Hãy lái tank Pegasus theo tôi. Nhớ rằng chế độ này không mang theo trợ thủ nhé!", "Đợi tôi với!", "yd_031_t.swf", 101, 0, "", ""], "54": [1, 0, "Làm tốt lắm! Hãy nhận gói quà của bạn nào!", "Nhận quà thôi!", "", 0, 8009, "", ""], "61": [1, 0, "Để chúc mừng bạn hoàn thành huấn luyện, tôi đã chuẩn bị rất nhiều quà. Mau đến nhận nhé!", "Tất cả đều dành cho tôi sao?", "yd_041_t.swf", 0, 0, "", ""], "62": [1, 0, "Quà hấp dẫn chứ? Hoàn thành nhiệm vụ sẽ giúp bạn nhận thêm nhiều phần thưởng nữa!", "Tuyệt vời!", "yd_042_t.swf", 0, 8006, "\\ui\\levelup.mp3", ""], "64": [1, 65, "Nâng cấp tank sẽ giúp bạn chiến đấu mạnh mẽ hơn trong đấu trường.", "Tôi nhớ rồi!", "", 0, 0, "", ""], "65": [1, 0, "Hãy nâng tank lên cấp 2. Sức mạnh và hình dạng chiến đấu của tank sẽ thay đổi đấy!", "Tôi muốn thử ngay!", "", 0, 0, "", ""], "66": [1, 0, "Tank đã mạnh hơn rồi, cả hình dạng cũng đẹp hơn nữa!", "Trông lợi hại thật!", "up_tianqi_t.swf", 0, 4502, "\\ui\\levelup.mp3", ""], "69": [1, 0, "Gần đây bạn làm tốt lắm! Hãy trải nghiệm những quyền lợi VIP nhé!", "Thích quá!", "", 0, 0, "", ""], "71": [1, 0, "Trận chiến thực sự sắp bắt đầu! Bạn đã sẵn sàng chưa?", "Luôn sẵn sàng!", "yd_061_t.swf", 0, 0, "", ""], "72": [1, 0, "Chiến binh thực thụ trưởng thành qua những trận chiến!", "Tôi sẽ cố gắng!", "yd_062_t.swf", 0, 8007, "\\ui\\levelup.mp3", ""], "73": [1, 0, "Làm tốt lắm! Sắp đến trận đánh Boss rồi. Hãy cường hóa trợ thủ trước nhé!", "Cuối cùng cũng được đánh Boss!", "", 0, 0, "", ""], "74": [1, 0, "Cường hóa giúp tăng khả năng tấn công và phòng thủ của trợ thủ. Hãy xây dựng trợ thủ phù hợp với cách chơi của bạn!", "Tôi sẽ làm được!", "", 0, 0, "", ""], "75": [1, 0, "Bây giờ hãy tăng sao cho trợ thủ. Dù có thể thất bại, nhưng khi thành công, sức mạnh sẽ tăng đáng kể!", "Đáng để thử!", "yd_072_t.swf", 0, 0, "", ""], "76": [1, 0, "Chúc mừng tăng sao thành công! Sức chiến đấu của bạn đã tăng lên rất nhiều!", "Tuyệt quá!", "", 0, 0, "", ""], "81": [5, 0, "Mở khóa Vòng quay bí ẩn", "", "jiesuo_05.jpg", 0, 0, "\\ui\\levelup.mp3", "5"], "91": [1, 0, "Chúng ta đã kiếm được nhiều tài nguyên qua chiến đấu. Hãy dùng chúng để mua một tank mới!", "Tôi thích tank mới!", "", 0, 0, "", ""], "92": [1, 0, "Tank mới tuyệt chứ? Tôi rất thích tuyệt chiêu của Iron Man, có thể bắn tan mọi chướng ngại!", "Sức mạnh đáng gờm thật!", "", 0, 9006, "", ""], "101": [1, 0, "Bạn đã hạ Boss và giải cứu nữ nghiên cứu viên!", "Đó là nhiệm vụ của tôi!", "yd_071_t.swf", 0, 0, "", ""], "102": [1, 0, "Nhiệm vụ tiếp theo rất khó. Với sức mạnh trợ thủ hiện tại, bạn cần chuẩn bị thật kỹ!", "Tôi sẽ chuẩn bị!", "yd_072_t.swf", 0, 0, "", ""], "207": [1, 0, "Bạn thể hiện xuất sắc quá! Tôi phải tặng bạn gói quà này mới được.", "Tôi thích quà lắm!", "", 0, 0, "", ""], "411": [1, 0, "Trợ thủ là đồng đội đắc lực trong phụ bản. Nâng cấp trợ thủ sẽ giúp tăng đáng kể sức chiến đấu.", "Vậy hãy nâng cấp nào!", "", 0, 0, "", ""], "412": [1, 0, "Chúc mừng trợ thủ đã lên cấp 3! Cấp càng cao, sức mạnh càng lớn!", "Tuyệt quá!", "", 0, 4103, "\\ui\\levelup.mp3", ""], "413": [5, 0, "Mở khóa VIP", "", "jiesuo_03.jpg", 0, 0, "\\ui\\levelup.mp3", "3"]}

